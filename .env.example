# ===== Supabase (Backend as a Service - Free tier) =====
# Lấy URL và ANON KEY từ Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# (Tùy chọn) Tên bucket lưu ảnh sản phẩm trên Supabase Storage
# Mặc định: products
VITE_SUPABASE_BUCKET=products
